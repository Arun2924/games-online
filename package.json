{
  "name": "gamehub",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
